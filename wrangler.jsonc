{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "global-button-game",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws"]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_COUNTER",
        "class_name": "GlobalCounter"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GlobalCounter"]
    }
  ]
}
